msgstr "Fungua Akaunti"

msgid "Username"
msgstr "Jina la mtumiaji"

msgid "Password"
msgstr "Nenosiri"

msgid "Password confirmation"
msgstr "Thibitisha nenosiri"

msgid "Email address"
msgstr "Anwani ya barua pepe"

msgid "Signed in as"
msgstr "Umeingia kama"

msgid "Save changes"
msgstr "Hifadhi mabadiliko"

msgid "Order"
msgstr "Agizo"

msgid "Date"
msgstr "Tarehe"

msgid "Payment"
msgstr "Malipo"

msgid "No orders yet."
msgstr "Bado huna maagizo."

msgid "New to Electro?"
msgstr "Je, wewe ni mteja mpya wa Electro?"

msgid "Already registered?"
msgstr "Tayari umesajiliwa?"

msgid "Your account has been created."
msgstr "Akaunti yako imefunguliwa."

msgid "Your account details have been updated."
msgstr "Maelezo ya akaunti yako yamesasishwa."
